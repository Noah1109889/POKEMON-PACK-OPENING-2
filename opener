<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Riftbreakers | Pack Lab</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{--ink:#111827;--muted:#64748b;--paper:#f7f6f1;--line:#d9d6ca;--lime:#d7f15a;--orange:#ff6b35;--cyan:#55dbe5;--pink:#ff5c8a;--gold:#f3bd48;--shadow:0 18px 45px #19222b18}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px 'Space Grotesk',sans-serif;overflow-x:hidden}button{font:inherit;border:0;cursor:pointer;color:inherit} .app{min-height:100vh;background:radial-gradient(circle at 82% 12%,#e9f3d7 0 15%,transparent 38%),linear-gradient(130deg,#f7f6f1,#eeeae0)}
header{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 5vw;background:#f9f8f3dd;backdrop-filter:blur(10px);position:sticky;top:0;z-index:5}.brand{display:flex;align-items:center;gap:12px;font:800 25px 'Barlow Condensed';letter-spacing:.5px}.brand-mark{width:32px;height:32px;background:var(--ink);color:var(--lime);display:grid;place-items:center;transform:rotate(-8deg);font-weight:800}.wallet{display:flex;align-items:center;gap:10px}.cash{font-weight:700;background:white;border:1px solid var(--line);padding:10px 16px;border-radius:99px}.earn{background:var(--lime);padding:11px 16px;border-radius:99px;font-weight:700;box-shadow:3px 3px 0 var(--ink);transition:.15s}.earn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}
main{max-width:1280px;margin:auto;padding:28px 5vw 70px}.ticker{display:flex;gap:18px;align-items:center;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:1.4px;margin-bottom:26px}.dot{height:7px;width:7px;background:var(--orange);border-radius:50%;box-shadow:0 0 0 5px #ff6b3524}.layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr);gap:34px}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:700;color:var(--orange);text-transform:uppercase}.title{font:800 clamp(44px,6vw,78px)/.88 'Barlow Condensed';max-width:650px;margin:8px 0 15px;text-transform:uppercase;letter-spacing:-1px}.lede{max-width:610px;color:#4e5a68;line-height:1.6;margin:0 0 24px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.tab{background:transparent;border:1px solid var(--line);padding:10px 14px;font-weight:700;border-radius:5px}.tab.active{background:var(--ink);color:white;border-color:var(--ink)}
.pack-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.pack{background:white;border:1px solid var(--line);padding:13px;border-radius:8px;cursor:pointer;box-shadow:0 5px 0 #d5d1c5;transition:.2s}.pack:hover,.pack.selected{transform:translateY(-4px);box-shadow:0 9px 0 #d5d1c5}.pack.selected{border:2px solid var(--orange)}.pack-art{height:116px;border-radius:4px;display:grid;place-items:center;position:relative;overflow:hidden;color:white;font:800 35px 'Barlow Condensed';text-transform:uppercase}.pack-art:before,.pack-art:after{content:"";position:absolute;width:150%;height:15px;background:#ffffff33;transform:rotate(-32deg)}.pack-art:after{transform:rotate(-32deg) translateY(32px)}.neon{background:linear-gradient(135deg,#17212c,#bd3e70)}.arc{background:linear-gradient(135deg,#073d53,#2cb6b9)}.vault{background:linear-gradient(135deg,#192114,#bb7b20)}.pack h3{font:700 22px 'Barlow Condensed';margin:12px 0 2px}.pack small{color:var(--muted)}.pack-price{margin-top:12px;font-weight:700;color:var(--orange)}
.stage{min-height:560px;background:#18222c;position:relative;overflow:hidden;border-radius:10px;box-shadow:var(--shadow);padding:25px;color:white}.stage:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 45%,#ffffff0b 45% 46%,transparent 46% 70%,#d7f15a0b 70% 71%,transparent 71%),radial-gradient(circle at 15% 15%,#55dbe526,transparent 30%)}.stage>*{position:relative}.stage-top{display:flex;justify-content:space-between;color:#aab6bc;font-size:11px;letter-spacing:1.5px;text-transform:uppercase}.pack-pod{height:330px;display:grid;place-items:center;position:relative}.pack-visual{width:180px;height:245px;border-radius:7px;background:linear-gradient(140deg,#fa5d85,#7b2f95);box-shadow:16px 15px 0 #0f151b,0 0 70px #ff5c8a66;transform:rotate(4deg);display:flex;align-items:center;justify-content:center;text-align:center;font:800 42px/ .8 'Barlow Condensed';text-transform:uppercase;color:#ffe76c;transition:.5s}.pack-visual.ripping{animation:shake .16s infinite;filter:saturate(1.5)}.pack-visual.open{transform:rotate(-10deg) translateY(-40px);opacity:0}.pack-visual:after{content:"RIFT\A BREAKERS";white-space:pre;position:absolute;inset:0;display:grid;place-items:center}.tear-line{position:absolute;width:240px;height:3px;border-top:2px dashed #ffffff66;top:51%;left:50%;transform:translate(-50%,-50%) rotate(-6deg)}.rip-copy{color:#c2cbd0;text-align:center;font-size:12px}.rip-row{display:flex;gap:10px;align-items:center;margin-top:16px}.rip-row input{accent-color:var(--lime);width:100%}.rip-button{background:var(--lime);font-weight:800;color:var(--ink);padding:13px 18px;border-radius:4px;white-space:nowrap}.rip-button:disabled{opacity:.5;cursor:not-allowed}.meter{height:6px;background:#43505a;margin-top:10px}.meter i{display:block;height:100%;background:var(--lime);width:50%;transition:.2s}.stage-message{text-align:center;min-height:20px;margin-top:12px;color:#e1e8e8;font-size:12px}
#fx{position:absolute;inset:0;pointer-events:none;overflow:hidden}.spark{position:absolute;width:7px;height:24px;background:var(--lime);animation:burst 1.1s ease-out forwards}.spark:nth-child(3n){background:var(--pink)}.spark:nth-child(4n){background:var(--gold)}@keyframes burst{from{transform:translate(0,0) rotate(0);opacity:1}to{transform:translate(var(--x),var(--y)) rotate(500deg);opacity:0}}@keyframes shake{0%,100%{transform:rotate(4deg) translateX(0)}50%{transform:rotate(4deg) translateX(5px)}}
.section{margin-top:44px}.section-head{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:16px}.section h2{font:700 32px 'Barlow Condensed';margin:0;text-transform:uppercase}.hint{font-size:12px;color:var(--muted)}.collection{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:16px}.card{min-height:260px;border-radius:7px;padding:14px;background:#fff;border:1px solid var(--line);box-shadow:0 7px 0 #d5d1c5;position:relative;overflow:hidden}.card-art{height:145px;border-radius:4px;display:grid;place-items:center;color:#fff;font:800 28px 'Barlow Condensed';text-align:center;text-transform:uppercase;position:relative}.card-art:after{content:"";position:absolute;inset:0;background:linear-gradient(125deg,transparent 42%,#fff5 43% 46%,transparent 47%)}.card-name{font-weight:700;margin-top:11px}.card-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:4px}.rarity{font-size:10px;letter-spacing:1px;text-transform:uppercase;font-weight:700}.r-common{color:#718096}.r-rare{color:#2384a4}.r-epic{color:#9a4dc3}.r-legendary{color:#d18417}.r-mythic{color:#e33f70}.card.locked{opacity:.45;filter:grayscale(1)}.grade-btn{margin-top:12px;width:100%;padding:9px;background:var(--ink);color:white;border-radius:3px;font-weight:700}.slab{border:4px solid #d8edf0;background:#e9f7f7cc;box-shadow:inset 0 0 0 1px #91c6c7,0 6px 0 #c5d1d0}.slab .card-art{border:2px solid #a7cbd0}.grade-badge{position:absolute;right:10px;top:10px;background:white;border:2px solid var(--ink);font:800 18px 'Barlow Condensed';padding:5px;color:var(--orange)}
.machine{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center;background:var(--ink);color:white;padding:24px;border-radius:8px;overflow:hidden;position:relative}.machine h3{font:800 38px/.9 'Barlow Condensed';text-transform:uppercase;margin:0 0 10px;color:var(--lime)}.machine p{color:#aeb9c1;line-height:1.5}.slot{border:1px solid #ffffff33;background:#2b3740;border-radius:7px;padding:18px;text-align:center}.slot-window{height:100px;background:#10171c;display:grid;place-items:center;font-size:48px;margin-bottom:14px;border:2px solid #ffffff22}.spin{background:var(--orange);color:white;font-weight:800;padding:12px 22px;border-radius:4px}.spin:disabled{opacity:.5}.skin-name{color:var(--lime);font-weight:700;min-height:20px}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);background:var(--ink);color:white;padding:14px 20px;border-left:4px solid var(--lime);opacity:0;pointer-events:none;transition:.3s;z-index:10}.toast.show{opacity:1;transform:translate(-50%,0)}
.modal{position:fixed;inset:0;background:#111827cc;display:none;place-items:center;z-index:8;padding:20px}.modal.open{display:grid}.scene{max-width:600px;width:100%;background:#202d38;color:white;padding:34px;text-align:center;border:2px solid var(--lime);box-shadow:0 0 80px #d7f15a55;animation:pop .4s}.scene h2{font:800 55px/.9 'Barlow Condensed';color:var(--gold);text-transform:uppercase;margin:10px}.scene .scene-creature{font:800 80px 'Barlow Condensed';color:var(--pink);text-shadow:8px 8px 0 #552d60}.scene p{color:#c9d1d5}.close{background:var(--lime);padding:12px 25px;font-weight:800;margin-top:14px}@keyframes pop{from{transform:scale(.8);opacity:0}to{transform:scale(1);opacity:1}}
@media(max-width:800px){header{padding:0 20px}.wallet{gap:5px}.earn{padding:9px;font-size:12px}.cash{padding:9px;font-size:12px}main{padding:22px 20px 50px}.layout{grid-template-columns:1fr}.stage{min-height:500px}.pack-grid{grid-template-columns:1fr}.pack-art{height:80px}.machine{grid-template-columns:1fr}.title{font-size:56px}}
</style>
</head>
<body><div class="app">
<header><div class="brand"><span class="brand-mark">R</span> RIFTBREAKERS</div><div class="wallet"><span class="cash">$ <b id="money">120</b></span><button class="earn" id="earn">+ $1 FIELD BONUS</button></div></header>
<main>
<div class="ticker"><span class="dot"></span> Season 01: Neon Wilds <span>•</span> <span id="status">Lab online</span></div>
<div class="layout"><section><div class="eyebrow">Original creature card lab</div><h1 class="title">Rip it right.<br><em>Pull something unreal.</em></h1><p class="lede">Every pack is a tiny gamble with a physical feel. Control the tear, protect the card, and send your best pulls into the grading chamber.</p><div class="tabs"><button class="tab active">PACK BAY</button><button class="tab" onclick="document.getElementById('collection').scrollIntoView({behavior:'smooth'})">COLLECTION</button><button class="tab" onclick="document.getElementById('machine').scrollIntoView({behavior:'smooth'})">SKIN MACHINE</button></div><div class="pack-grid" id="packs"></div></section>
<section class="stage"><div class="stage-top"><span>LIVE OPEN // <b id="packLabel">Neon Wilds</b></span><span id="odds">5 cards / 1 guaranteed rare</span></div><div class="pack-pod"><div class="pack-visual" id="packVisual"></div><div class="tear-line"></div><div id="fx"></div></div><div class="rip-copy">Set the tear strength, then commit. A gentle rip protects corners. A wild rip is faster, but risky.</div><div class="rip-row"><input id="ripRange" type="range" min="1" max="100" value="38"><button class="rip-button" id="ripButton">RIP PACK</button></div><div class="meter"><i id="meter"></i></div><div class="stage-message" id="stageMessage">Choose a pack, then make your move.</div></section></div>
<section class="section" id="collection"><div class="section-head"><h2>Your pulls</h2><span class="hint">Grade a card to seal it in a clear slab.</span></div><div class="collection" id="cards"><div class="hint">Your first pull is waiting in the pack bay.</div></div></section>
<section class="section" id="machine"><div class="section-head"><h2>Slab skin machine</h2><span class="hint">Cosmetics only. The card stays yours.</span></div><div class="machine"><div><h3>Make it yours.</h3><p>Spin for a new slab finish or card camo. One pull costs $35. Duplicate skins convert to $10.</p><div class="skin-name" id="skinName">Machine ready</div></div><div class="slot"><div class="slot-window" id="slotWindow">?</div><button class="spin" id="spin">SPIN FOR $35</button></div></div></section>
</main></div><div class="toast" id="toast"></div><div class="modal" id="modal"><div class="scene"><div class="eyebrow">Rare signal detected</div><div class="scene-creature" id="sceneCreature">???</div><h2 id="sceneTitle">The rift opens</h2><p id="sceneText">Something impossible made it through the foil.</p><button class="close" id="closeModal">ADD TO COLLECTION</button></div></div>
<script>
const packs=[{id:'neon',name:'Neon Wilds',price:25,art:'NEON',class:'neon',guarantee:'1 rare+'},{id:'arc',name:'Arc Current',price:60,art:'ARC',class:'arc',guarantee:'1 epic+'},{id:'vault',name:'Solar Vault',price:120,art:'VAULT',class:'vault',guarantee:'1 legendary+'}];
const creatures=[
{name:'Morrowisp',rarity:'Common',value:8,art:'MORROW\nWISP',color:'#5c778b'},
{name:'Brimble',rarity:'Common',value:10,art:'BRIMBLE',color:'#bd684b'},
{name:'Tidebit',rarity:'Common',value:12,art:'TIDEBIT',color:'#2e9eb5'},
{name:'Glintusk',rarity:'Rare',value:32,art:'GLINTUSK',color:'#2384a4'},
{name:'Vesperlynx',rarity:'Rare',value:38,art:'VESPER\nLYNX',color:'#4f6eac'},
{name:'Cindervane',rarity:'Epic',value:75,art:'CINDER\nVANE',color:'#9a4dc3'},
{name:'Orreryx',rarity:'Epic',value:90,art:'ORRERYX',color:'#6b55b7'},
{name:'Solvyr',rarity:'Legendary',value:180,art:'SOLVYR',color:'#c18a21'},
{name:'Astraforge',rarity:'Legendary',value:240,art:'ASTRA\nFORGE',color:'#d18417'},
{name:'Nullflare',rarity:'Mythic',value:600,art:'NULL\nFLARE',color:'#e33f70'}];
const skins=['Clear Ice','Signal Lime','Heatwave Orange','Midnight Chrome','Prism Camo','Tideglass'];let money=120, selected=packs[0], pulls=[], pendingGrade=null;
const $=id=>document.getElementById(id); const moneyEl=$('money');
function renderPacks(){ $('packs').innerHTML=packs.map(p=>`<div class="pack ${p.id===selected.id?'selected':''}" data-id="${p.id}"><div class="pack-art ${p.class}">${p.art}</div><h3>${p.name}</h3><small>5 cards · ${p.guarantee}</small><div class="pack-price">$${p.price}</div></div>`).join('');document.querySelectorAll('.pack').forEach(el=>el.onclick=()=>{selected=packs.find(p=>p.id===el.dataset.id);$('packLabel').textContent=selected.name;$('odds').textContent=`5 cards / ${selected.guarantee}`;renderPacks();});}
function setMoney(n){money=Math.max(0,n);moneyEl.textContent=money}
function toast(text){const t=$('toast');t.textContent=text;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
function rarityFor(){let r=Math.random();if(selected.id==='vault'&&r<.15)return'Mythic';if(selected.id==='vault'&&r<.42)return'Legendary';if(selected.id==='arc'&&r<.12)return'Legendary';if(selected.id==='arc'&&r<.38)return'Epic';if(r<.06)return'Mythic';if(r<.18)return'Legendary';if(r<.36)return'Epic';if(r<.63)return'Rare';return'Common'}
function pickCard(){let rarity=rarityFor();let list=creatures.filter(c=>c.rarity===rarity);return {...list[Math.floor(Math.random()*list.length)],id:Date.now()+Math.random(),condition:Math.max(35,Math.round(100-(+$('ripRange').value-38)*.35+Math.random()*12-6))}}
function burst(){let fx=$('fx');fx.innerHTML='';for(let i=0;i<42;i++){let s=document.createElement('i');s.className='spark';s.style.left='50%';s.style.top='49%';s.style.setProperty('--x',`${(Math.random()-.5)*600}px`);s.style.setProperty('--y',`${(Math.random()-.5)*500}px`);s.style.transform=`rotate(${Math.random()*90}deg)`;fx.append(s)}setTimeout(()=>fx.innerHTML='',1300)}
function openPack(){if(money<selected.price){toast('Not enough cash. Hit the field bonus.');return}setMoney(money-selected.price);let strength=+$('ripRange').value;$('ripButton').disabled=true;$('packVisual').classList.add('ripping');$('stageMessage').textContent=strength>70?'That tear is aggressive...':'Clean pressure. Keep the corners safe.';setTimeout(()=>{let cards=Array.from({length:5},pickCard);pulls.push(...cards);$('packVisual').classList.remove('ripping');$('packVisual').classList.add('open');burst();let best=cards.sort((a,b)=>b.value-a.value)[0];if(['Legendary','Mythic'].includes(best.rarity)){setTimeout(()=>showScene(best),500)}else{toast(`${best.rarity} signal: ${best.name} added`);renderCards()}setTimeout(()=>{$('packVisual').classList.remove('open');$('ripButton').disabled=false;$('stageMessage').textContent='Choose another pack when you are ready.'},1200)},850)}
function showScene(card){$('sceneCreature').textContent=card.art.replace('\\n',' / ');$('sceneTitle').textContent=card.rarity==='Mythic'?'THE NULL EVENT':'A LEGEND ARRIVES';$('sceneText').textContent=`${card.name} crossed the foil with ${card.condition}% surface condition. That is a serious pull.`;$('modal').classList.add('open');pendingGrade=card;renderCards()}
function renderCards(){let el=$('cards');if(!pulls.length){el.innerHTML='<div class="hint">Your first pull is waiting in the pack bay.</div>';return}el.innerHTML=pulls.slice().reverse().map(c=>`<article class="card ${c.grade?'slab':''}"><div class="card-art" style="background:${c.color}">${c.art.replace('\\n','<br>')}</div>${c.grade?`<div class="grade-badge">${c.grade}/10</div>`:''}<div class="card-name">${c.name}</div><div class="card-meta"><span class="rarity r-${c.rarity.toLowerCase()}">${c.rarity}</span><span>$${c.grade?c.value*(c.grade+1):c.value}</span></div>${c.grade?`<div class="card-meta"><span>${c.skin||'Clear Ice'} slab</span><span>SEALED</span></div>`:`<button class="grade-btn" onclick="gradeCard('${c.id}')">GRADE CARD · $15</button>`}</article>`).join('')}
function gradeCard(id){let c=pulls.find(x=>String(x.id)===id);if(!c||c.grade)return;if(money<15){toast('Grading costs $15. Earn a field bonus first.');return}setMoney(money-15);let score=Math.max(1,Math.min(10,Math.round(c.condition/10+Math.random()*.8-.4)));c.grade=score;c.skin=skins[Math.floor(Math.random()*skins.length)];renderCards();toast(`${c.name} graded ${score}/10 · slab sealed`)}
$('ripRange').oninput=e=>$('meter').style.width=e.target.value+'%';$('ripButton').onclick=openPack;$('earn').onclick=()=>{setMoney(money+1);toast('Field bonus collected: +$1')};$('closeModal').onclick=()=>{$('modal').classList.remove('open');if(pendingGrade){toast(`${pendingGrade.name} is waiting for grading`);pendingGrade=null}};
$('spin').onclick=()=>{if(money<35){toast('You need $35 to spin.');return}setMoney(money-35);$('spin').disabled=true;let i=0;let timer=setInterval(()=>{$('slotWindow').textContent='◆';$('skinName').textContent=skins[Math.floor(Math.random()*skins.length)];if(++i>10){clearInterval(timer);let skin=skins[Math.floor(Math.random()*skins.length)];$('slotWindow').textContent='✦';$('skinName').textContent=skin;$('spin').disabled=false;toast(`Unlocked ${skin} finish`)}} ,90)};
renderPacks();renderCards();$('meter').style.width=$('ripRange').value+'%';
</script></body></html>
